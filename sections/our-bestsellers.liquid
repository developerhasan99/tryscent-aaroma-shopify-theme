{{ 'pm-s-our-bestsellers.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign band_collection = section.settings.collection
  if band_collection == blank
    assign band_collection = collections.all
  endif
  assign band_limit = section.settings.limit | default: 20
-%}

<div
  id="{{ section.id }}"
  class="pm-seoband pm-band--surface section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="pm-eyebrow pm-muted pm-seoband__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <ul class="pm-seoband__list" role="list">
      {%- for product in band_collection.products limit: band_limit -%}
        {%- if product.metafields.custom.inspiration -%}
          <li class="pm-seoband__item">{{ section.settings.prefix | escape }}
            <a class="pm-seoband__link" href="{{ product.url }}">{{ product.metafields.custom.inspiration.value.name }}</a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
  {
    "name": "Our Bestsellers",
  "class": "pm-scope",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Our bestsellers"
      },
      {
        "type": "text",
        "id": "prefix",
        "label": "Text before each designer name",
        "default": "Inspired by:"
      },
      {
        "type": "collection",
        "id": "collection",
        "label": "Collection",
        "info": "Leave empty to list the whole catalogue."
      },
      {
        "type": "range",
        "id": "limit",
        "min": 5,
        "max": 40,
        "step": 5,
        "unit": "pcs",
        "label": "Number of links",
        "default": 20
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background Color",
        "default": "#fcfbf9",
        "info": "Not used in the premium design: the band always uses the panel surface colour."
      },
      {
        "type": "header",
        "content": "t:sections.all.padding.section_padding_heading"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 36
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 36
      }
    ],
    "presets": [
      {
        "name": "Our Bestsellers"
      }
    ]
  }
{% endschema %}
