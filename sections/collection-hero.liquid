{%- assign hero_mobile_image = collection.metafields.custom.hero_mobile_image -%}
{%- assign hero_desktop_image = collection.image -%}
{{ 'collection-description.css' | asset_url | stylesheet_tag }}
<div class="chero relative flex h-auto min-h-[520px] items-end bg-[#eef1f3] bg-[image:var(--hero-img-mobile)] bg-cover bg-[position:50%_50%] bg-no-repeat pb-[34px] sm:h-[clamp(430px,33.33vw,600px)] sm:min-h-0 sm:items-center sm:bg-[image:var(--hero-img-desktop)] sm:bg-[position:50%_50%] sm:pb-0" style="{% if hero_mobile_image %}--hero-img-mobile: url('{{ hero_mobile_image | image_url: width: 750 }}');{% endif %} {% if hero_desktop_image %}--hero-img-desktop: url('{{ hero_desktop_image | image_url: width: 1920 }}');{% endif %}">
  <div class="!block absolute inset-0 bg-[linear-gradient(180deg,rgba(246,247,248,0)_38%,rgba(246,247,248,.82)_58%,rgba(246,247,248,.97)_74%,#f6f7f8_100%)] sm:bg-[linear-gradient(90deg,rgba(248,248,247,.97)_0%,rgba(248,248,247,.93)_30%,rgba(248,248,247,.72)_46%,rgba(248,248,247,0)_68%)]"></div>
  <div class="page-width relative z-[1] w-full">
    <div class="chero__col md:w-1/2 {%  if hero_mobile_image != blank %} pt-80 md:pt-0 {% endif %}">
      {% if section.settings.show_rating_badge %}
        <p class="mb-[10px] flex items-center gap-1.5 text-xs font-bold uppercase tracking-[0.16em] text-[#8f6329]">
          <span class="tracking-[0.06em]">★★★★★</span>
          {{ section.settings.rating_text }}
        </p>
      {% endif %}
      <h1 class="mb-3 whitespace-nowrap text-[clamp(28px,2.8vw,44px)] font-normal leading-[1.1] tracking-[-0.015em] text-[#14181c]" style="font-family: Georgia, 'Times New Roman', serif;">
        {{ collection.title }}
      </h1>
      {%- if collection.description != blank -%}
        {%- render 'collection-description',
          description: collection.description,
          id: section.id,
          more_label: section.settings.description_more_label,
          less_label: section.settings.description_less_label,
          variant: 'hero'
        -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Collection Hero",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_rating_badge",
        "label": "Show rating badge",
        "default": true
      }, {
        "type": "text",
        "id": "rating_text",
        "label": "Rating badge text",
        "default": "Verifiziert von über 10.000 Duftliebhabern"
      }, {
        "type": "text",
        "id": "description_more_label",
        "label": "Description: show more",
        "default": "Read more",
        "info": "The description shows its first two sentences; this opens the rest"
      }, {
        "type": "text",
        "id": "description_less_label",
        "label": "Description: show less",
        "default": "Read less"
      }
    ],
    "presets": [
      {
        "name": "Collection Hero"
      }
    ]
  }
{% endschema %}