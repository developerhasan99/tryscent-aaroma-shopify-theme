{{ 'pm-s-makes-different-list.css' | asset_url | stylesheet_tag }}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign why_image = section.settings['makes-different-image']
  assign why_btn_text = section.settings['makes-different-btn-text']
  assign why_btn_link = section.settings['makes-different-btn-link']
-%}

<div id="{{ section.id }}" class="pm-why color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="pm-why__grid">
      <div class="pm-why__text">
        {%- if section.settings.makes_diferent_title != blank -%}
          <h2 class="pm-why__title pm-title">{{ section.settings.makes_diferent_title | escape }}</h2>
        {%- endif -%}
        <ul class="pm-why__list" role="list">
          {%- for block in section.blocks -%}
            <li class="pm-why__row" {{ block.shopify_attributes }}>
              {%- render 'pm-icon', icon: 'check-circle', size: 24, stroke: 1.5, class: 'pm-why__icon' -%}
              <div class="pm-why__body">
                {%- if block.settings.title != blank -%}
                  <h3 class="pm-why__row-title">{{ block.settings.title | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <p class="pm-why__row-desc pm-muted">{{ block.settings.description | escape }}</p>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ul>
        {%- if why_btn_text != blank and why_btn_link != blank -%}
          <a href="{{ why_btn_link }}" class="pm-btn pm-btn--primary pm-why__cta">{{ why_btn_text | escape }}</a>
        {%- endif -%}
      </div>
      <div class="pm-why__media">
        {%- if why_image != blank -%}
          {{ why_image | image_url: width: 1200 | image_tag: widths: '375, 600, 750, 900, 1200', sizes: '(min-width: 990px) 600px, calc(100vw - 2 * 20px)', class: 'pm-why__img', loading: 'lazy', alt: section.settings.makes_diferent_title }}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Makes Different List",
    "class": "makes-different-list pm-scope",
    "settings": [
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "t:sections.all.colors.label",
        "default": "scheme-1"
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background Color",
        "info": "Unused since the premium redesign; the colour scheme sets the background.",
        "default": "#FFFFFF"
      },
      {
        "type": "text",
        "id": "makes_diferent_title",
        "label": "Title",
        "default": "What makes Magic Perfume different?"
      },
      {
        "type": "image_picker",
        "id": "makes-different-image",
        "label": "Section Image"
      },
      {
        "type": "text",
        "id": "makes-different-btn-text",
        "label": "Button Text",
        "default": "Click Here"
      }, {
        "type": "url",
        "id": "makes-different-btn-link",
        "label": "Button Link",
        "info": "The button only renders when both text and link are set."
      },
      {
        "type": "header",
        "content": "t:sections.all.padding.section_padding_heading"
      }, {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "info": "Mobile uses half of this value.",
        "default": 72
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "info": "Mobile uses half of this value.",
        "default": 72
      }
    ],
    "blocks": [
      {
        "type": "list_item",
        "name": "List Item",
        "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Title"
          }, {
            "type": "text",
            "id": "description",
            "label": "Description"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Makes Different",
        "blocks": [
          {
            "type": "list_item"
          }
        ]
      }
    ]
  }
{% endschema %}
