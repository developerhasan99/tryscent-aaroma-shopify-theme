{%- liquid
  assign ticker_style = section.settings.style | default: 'legacy'
  assign ticker_speed = section.settings.speed | default: 24
  assign ticker_sep = section.settings.separator
-%}
{%- if ticker_style == 'premium' -%}
  {{ 'pm-s-marquee-labels.css' | asset_url | stylesheet_tag }}
  {%- style -%}
    .premium .pm-ticker--{{ section.id }} {
      --pm-ticker-dur: {{ ticker_speed }}s;
    }
  {%- endstyle -%}
  <div class="pm-ticker pm-ticker--{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
    <div class="pm-ticker__track">
      {%- for copy in (1..2) -%}
        <div class="pm-ticker__group"{% if copy == 2 %} aria-hidden="true"{% endif %}>
          {%- for repeat in (1..3) -%}
            {%- for block in section.blocks -%}
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="pm-ticker__item"{% if copy == 2 or repeat > 1 %} tabindex="-1"{% endif %} {{ block.shopify_attributes }}>
              {%- else -%}
                <span class="pm-ticker__item" {{ block.shopify_attributes }}>
              {%- endif -%}
                {%- if block.settings.icon -%}
                  <img
                    src="{{ block.settings.icon | image_url: height: 32, width: 32 }}"
                    alt=""
                    height="32"
                    width="32"
                    loading="lazy">
                {%- endif -%}
                <span>{{ block.settings.label }}</span>
              {%- if block.settings.link != blank -%}
                </a>
              {%- else -%}
                </span>
              {%- endif -%}
              {%- if ticker_sep != blank -%}
                <span class="pm-ticker__sep" aria-hidden="true">{{ ticker_sep }}</span>
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- else -%}
<div class="overflow-hidden flex items-center whitespace-nowrap max-w-full bg-black py-3">
  {% for i in (1..2) %}
    <div class="flex gap-6 animate-move-left">
      {% for i in (1..3) %}
        {% for block in section.blocks %}
          <a href="{{ block.settings.link }}" class="flex items-center gap-1 no-underline hover:no-underline text-black">
            {% if block.settings.icon %}
              <img
                src="{{ block.settings.icon | image_url: height: 32, width: 32 }}"
                alt="{{ block.settings.label }}"
                class="inline-block mr-1 [filter:invert(1)]"
                height="32"
                width="32"
                style="height: 1.2em; width: auto; max-width: 1.2em;" />
            {% endif %}
            <span class="md:text-xs text-xs uppercase font-semibold text-white">
              {{ block.settings.label }}
            </span>
          </a>
        {% endfor %}
      {% endfor %}
    </div>
  {% endfor %}
</div>
{%- endif -%}

{% schema %}
  {
    "name": "Marquee Labels",
  "class": "pm-scope",
    "settings": [
      {
        "type": "select",
        "id": "style",
        "label": "Style",
        "info": "Legacy keeps the original green band. Premium renders the 40px ticker in the colour scheme below.",
        "options": [
          { "value": "legacy", "label": "Legacy (green band)" },
          { "value": "premium", "label": "Premium ticker" }
        ],
        "default": "legacy"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme (premium ticker)",
        "default": "scheme-3"
      },
      {
        "type": "range",
        "id": "speed",
        "label": "Loop duration",
        "min": 8,
        "max": 60,
        "step": 2,
        "unit": "s",
        "default": 24
      },
      {
        "type": "text",
        "id": "separator",
        "label": "Separator between labels",
        "default": "•"
      }
    ],
    "blocks": [
      {
        "type": "label",
        "name": "Label",
        "settings": [
          {
            "type": "image_picker",
            "id": "icon",
            "label": "Icon"
          }, {
            "type": "text",
            "id": "label",
            "label": "Label",
            "default": "Free Shipping"
          }, {
            "type": "url",
            "id": "link",
            "label": "Link"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Marquee Labels"
      }
    ]
  }
{% endschema %}
