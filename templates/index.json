    "massive_review_section": {
      "type": "massive-review",
      "blocks": {
        "review_GJGq9n": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/pinkm.png",
            "content": "<p>\"Happy with Aaroma. The scent closely resembles the original and lasts well. Neat packaging, nice bottle. Excellent choice for anyone looking for quality at a fair price.\"</p>",
            "author": "Alina M",
            "date": "5 months ago",
            "rating": 5,
            "show_verified_badge": false,
            "product": "black-berry-vanilla-musk"
          }
        },
        "review_jNFxYP": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/WhatsApp_Image_2026-09-09_at_8.35.58_AM.jpg",
            "content": "<p>\"One of my favorite scents. Delivered quickly. Lovely.\"</p>",
            "author": "Alex W.",
            "date": "2 days ago",
            "rating": 5,
            "show_verified_badge": true,
            "product": ""
          }
        },
        "review_eGyDpR": {
          "type": "review",
          "disabled": true,
          "settings": {
            "review_image": "shopify://shop_images/345.png",
            "content": "<p>\"Great product. A smart alternative to brand-name perfumes. Lasts a long time and you get great value for money.\"</p>",
            "author": "EM",
            "date": "4 months ago",
            "rating": 5,
            "show_verified_badge": true,
            "product": "bergamote-le-labo-bergamote-22"
          }
        },
        "review_gF6wKD": {
          "type": "review",
          "disabled": true,
          "settings": {
            "review_image": "shopify://shop_images/261_revie.png",
            "content": "<p>\"This is my first purchase and I'm already sold. I'll never buy perfume anywhere else. I'd been looking for an alternative that smells truly authentic for a long time - this is it.\"</p>",
            "author": "Killian P.",
            "date": "1 day ago",
            "rating": 5,
            "show_verified_badge": true,
            "product": "bergamot-sage-cedar-50-ml"
          }
        },
        "review_ByDgLX": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/2026-07-02_16h41_42.png",
            "content": "<p>\"This is the best perfume I've smelled in ages. The fragrance accords get me every time. This stays in my permanent collection.\"</p>",
            "author": "Jenniffer W.",
            "date": "2 days ago",
            "rating": 4,
            "show_verified_badge": true,
            "product": ""
          }
        },
        "review_dKt8hn": {
          "type": "review",
          "disabled": true,
          "settings": {
            "review_image": "shopify://shop_images/2026-07-02_16h55_49.png",
            "content": "<p>\"All three scents I received are very good. They last a long time and smell the way they should. My only disappointment was how long it took to receive them. But honestly, I placed a second order, so just expect a wait. Lol!<br/>\"</p>",
            "author": "Clara P.",
            "date": "2 days ago",
            "rating": 5,
            "show_verified_badge": true,
            "product": "apple-cinnamon-sandalwood"
          }
        },
        "review_DzktgE": {
          "type": "review",
          "disabled": true,
          "settings": {
            "review_image": "shopify://shop_images/2026-07-02_16h57_29.png",
            "content": "<p>\"Perfect and beautiful.\"</p>",
            "author": "Lidis A.",
            "date": "2 months ago",
            "rating": 5,
            "show_verified_badge": true,
            "product": "saffron-rose-amber-50-ml-1-7-fl-oz"
          }
        },
        "review_VrkHXh": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/Mounissa_Soilihi.jpg",
            "content": "<p>\"I'd been looking for years for a scent that smells luxurious and lasts a long time. This is exactly what I was looking for.\"</p>",
            "author": "Tiana N.",
            "date": "2 days ago",
            "rating": 4,
            "show_verified_badge": true,
            "product": "fresh-escape-premium"
          }
        },
        "review_myTAe8": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/WhatsApp_Image_2026-09-09_at_8.35.55_AM.jpg",
            "content": "<p>\"It smells very nice, but doesn't last as long as it should\"</p>",
            "author": "Terence M.",
            "date": "2 months ago",
            "rating": 5,
            "show_verified_badge": false,
            "product": ""
          }
        },
        "review_wczQWw": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/Camila_Sena_Oliveira_1.jpg",
            "content": "<p>\"I didn't know what to expect, but I'm pleasantly surprised. Super fresh and very close to Aventus. Lasts well and the price is much better.\"</p>",
            "author": "Michael T.",
            "date": "2 days ago",
            "rating": 4,
            "show_verified_badge": true,
            "product": "pineapple-smoke-vanilla-50-ml-1-7-fl-oz"
          }
        },
        "review_9fWXGn": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/Daria_Kononenko_2.jpg",
            "content": "<p>\"I love these perfumes. Every perfume I've received smells great. Some I even prefer to the original.\"</p>",
            "author": "Christine N.",
            "date": "5 days ago",
            "rating": 4,
            "show_verified_badge": false,
            "product": ""
          }
        },
        "review_iPjTCz": {
          "type": "review",
          "disabled": true,
          "settings": {
            "review_image": "shopify://shop_images/Celia_Sahki_1.jpg",
            "content": "<p>\"At first I was worried because shipping was slightly delayed, but once I received them, I was amazed by the scent. Once it settles, it's simply amazing.\"</p>",
            "author": "Lionel M.",
            "date": "7 days ago",
            "rating": 5,
            "show_verified_badge": true,
            "product": "4x-100ml-perfume-bottles"
          }
        },
        "review_YpX9h9": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/Carolina_Maresca_2.png",
            "content": "<p>\"Lovely scent. I love it.\"</p>",
            "author": "Castillo B.",
            "date": "3 months ago",
            "rating": 5,
            "show_verified_badge": true,
            "product": "tryscent-collection"
          }
        },
        "review_NBGz7p": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/Aleksandra_Kosin.jpg",
            "content": "<p>\"Wonderfully scented perfumes. The scents last a very long time. Excellent quality.\"</p>",
            "author": "Kamila G.",
            "date": "3 months ago",
            "rating": 5,
            "show_verified_badge": true,
            "product": "6x-30ml-perfume-bottles"
          }
        },
        "review_MBb63N": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/Claudia_Martins_4.png",
            "content": "<p>\"Smells exactly like Luna Rossa Carbon, for a fraction of the price. I can't believe how close it is to the original.\"</p>",
            "author": "Diana R.",
            "date": "4 months ago",
            "rating": 4,
            "show_verified_badge": false,
            "product": ""
          }
        },
        "review_hAJXhk": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/2026-07-02_16h58_13.png",
            "content": "<p>\"The scent that makes you feel put together. Not too heavy, just right.\"</p>",
            "author": "Michael R.",
            "date": "4 months ago",
            "rating": 5,
            "show_verified_badge": true,
            "product": "alpha-oil"
          }
        },
        "review_rad8A6": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/WhatsApp_Image_2026-09-09_at_8.35.50_AM.jpg",
            "content": "<p>\"I've worn Creed Aventus for years. This is the best alternative I've ever found, for a fraction of the price. The combination of pineapple and vanilla is spot on.\"</p>",
            "author": "Alvarez P.",
            "date": "4 months ago",
            "rating": 4,
            "show_verified_badge": true,
            "product": "pineapple-smoke-vanilla-50-ml-1-7-fl-oz"
          }
        },
        "review_BLYVmX": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/2026-07-02_16h49_01.png",
            "content": "<p>\"The product was neatly packaged. The perfume wasn't broken, didn't leak and was in good condition. The scent is perfect and didn't smell bad. I love it, high quality\"</p>",
            "author": "Anne E.",
            "date": "4 months ago",
            "rating": 4,
            "show_verified_badge": true,
            "product": "azure-dreams-pure"
          }
        },
        "review_eerxBx": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/Anastasiia_Komisarova.jpg",
            "content": "<p>\"Beautiful scent. Long-lasting. Sweet and warm. Delivered quickly. I'll definitely order again.\"</p>",
            "author": "Lucy R",
            "date": "4 months ago",
            "rating": 5,
            "show_verified_badge": true,
            "product": "6x-30ml-perfume-bottles"
          }
        },
        "review_UWgaKy": {
          "type": "review",
          "settings": {
