{% comment %}
  Search bar above the collection grid (sections/main-collection-product-grid.liquid, setting
  "Show the search bar"). Filters the grid by scent name, number, inspiration and tags; logic in
  assets/collection-search.js. No form and no name attribute: nothing reaches the URL or the
  filter bar. Port of magyx.co's snippet.

  aaroma: every line the script shows later (results, single result, no results, loading, the
  clear buttons) is page text rendered here, so Weglot translates it with the page (/nl-nl,
  /fr-be, ...). Text set by a script from a data-* attribute or a literal stays English. The
  status lines sit in .mgx-csearch__msgs (visually hidden, inert, out of the accessibility tree);
  the script copies the one it needs into the status line and fills in the count and the query.

  Accepts:
  - st: section.settings of the grid section
  - section_id: section.id
{% endcomment %}
{{ 'collection-search.css' | asset_url | stylesheet_tag }}
<script src="{{ 'collection-search.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign cs_count = '<span class="mgx-csearch__n" data-wg-notranslate>0</span>'
  assign cs_query = '<span class="mgx-csearch__q" data-wg-notranslate>&hellip;</span>'
  assign cs_results = st.search_results_text | escape | replace: '[count]', cs_count | replace: '[query]', cs_query
  assign cs_result = st.search_result_text | escape | replace: '[count]', cs_count | replace: '[query]', cs_query
  assign cs_empty = st.search_empty_text | escape | replace: '[count]', cs_count | replace: '[query]', cs_query
-%}

<div class="mgx-csearch page-width" data-mgx-csearch>
  <div class="mgx-csearch__inner" role="search">
    <label class="visually-hidden" for="MgxCollectionSearch-{{ section_id }}">{{ st.search_placeholder | default: 'Search this collection' | escape }}</label>
    <div class="mgx-csearch__field">
      <svg
        class="mgx-csearch__ico"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false">
        <circle cx="11" cy="11" r="7"/><path d="M20 20l-3.6-3.6"/>
      </svg>
      <input
        id="MgxCollectionSearch-{{ section_id }}"
        class="mgx-csearch__input"
        type="search"
        placeholder="{{ st.search_placeholder | escape }}"
        autocomplete="off"
        autocapitalize="off"
        autocorrect="off"
        spellcheck="false"
        enterkeyhint="search"
        aria-controls="product-grid">
      <button class="mgx-csearch__clear" type="button" hidden>
        <span aria-hidden="true">&times;</span>
        <span class="visually-hidden">{{ st.search_clear_label | escape }}</span>
      </button>
    </div>
    <p class="mgx-csearch__status" role="status" aria-live="polite" aria-atomic="true"></p>
    <div class="mgx-csearch__msgs visually-hidden" aria-hidden="true" inert>
      <span data-mgx-cs-msg="loading">{{ st.search_loading_text | escape }}</span>
      <span data-mgx-cs-msg="results">{{ cs_results }}</span>
      <span data-mgx-cs-msg="result">{{ cs_result }}</span>
      <span data-mgx-cs-msg="empty">
        {{- cs_empty }}
        <button type="button" class="mgx-csearch__reset">{{ st.search_clear_label | escape }}</button>
      </span>
    </div>
  </div>
</div>
