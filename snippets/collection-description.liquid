{%- comment -%}
  Collection description folded to its first two sentences (port of magyx.co ddcec4b, theessencevault.co.uk
  pattern). The rest (the remainder of that paragraph and every block after it) opens with an underlined
  "+ Read more" / "- Read less" toggle. Styles: assets/collection-description.css.

  The script below runs while the page is parsed, right after this markup and before the first paint, so the full
  text never flashes up. Without JavaScript the whole description shows and the toggle stays hidden (CSS shows it
  only once the script has folded the text).

  Weglot: the description and BOTH toggle labels are rendered here as page text, so Weglot translates them on the
  server. The script only splits the already translated text and switches which label is visible (CSS on
  aria-expanded); it never writes label text.

  Accepts:
  - description {String}: collection.description (HTML)
  - id {String}: unique id for this instance (section.id)
  - more_label {String}: "Read more" label (shown as "+ Read more")
  - less_label {String}: "Read less" label (shown as "- Read less")
  - variant {String}: 'banner' (centred column, main-collection-banner) or 'hero' (follows the hero's title)
  - class {String}: optional extra classes on the wrapper

  Usage:
  {% render 'collection-description', description: collection.description, id: section.id, more_label: section.settings.description_more_label, less_label: section.settings.description_less_label, variant: 'banner', class: 'collection-hero__description' %}
{%- endcomment -%}
{%- liquid
  assign more_label = more_label | default: 'Read more'
  assign less_label = less_label | default: 'Read less'
  assign variant = variant | default: 'banner'
-%}
<div class="cdesc cdesc--{{ variant }} rte{% if class != blank %} {{ class }}{% endif %}" data-cdesc>
  <div class="cdesc__text" id="CollectionDescription-{{ id }}">{{ description }}</div>
  <button
    type="button"
    class="cdesc__toggle"
    aria-expanded="false"
    aria-controls="CollectionDescription-{{ id }}"
  >
    <span class="cdesc__label cdesc__label--more">+ {{ more_label | escape }}</span>
    <span class="cdesc__label cdesc__label--less">- {{ less_label | escape }}</span>
  </button>
</div>
<script>
  (function () {
    // Shows the first two sentences of the description; the rest (the remainder of that paragraph and every block
    // after it) gets [hidden] until the toggle opens it. A sentence ends at . ! or ? followed by a space and a
    // capital, a quote, a bracket or a digit, or at the end of a paragraph; "No." / "Nr." before a number is not an end.
    var SHOWN = 2;
    var setup = function (root) {
      if (!root || !root.hasAttribute('data-cdesc') || root.dataset.cdescReady) return;
      root.dataset.cdescReady = '1';
      var text = root.querySelector('.cdesc__text');
      var toggle = root.querySelector('.cdesc__toggle');
      if (!text || !toggle) return;
      var blocks = [];
      var loose = false;
      for (var n = text.firstChild; n; n = n.nextSibling) {
        if (n.nodeType === 1) blocks.push(n);
        else if (n.nodeType === 3 && n.nodeValue.trim()) loose = true;
      }
      if (loose || !blocks.length) blocks = [text];
      var ends = function (str) {
        var out = [];
        var re = /[.!?]+["'“”’»)]*(?=\s+["'“‘„«(]?[A-Z0-9À-Ž])/g;
        var m;
        while ((m = re.exec(str))) {
          if (/\b(?:no|nr)\.$/i.test(str.slice(0, m.index + 1)) && /^\s+\d/.test(str.slice(re.lastIndex))) continue;
          out.push(re.lastIndex);
        }
        var trimmed = str.replace(/\s+$/, '');
        if (/[.!?]["'“”’»)]*$/.test(trimmed) && out[out.length - 1] !== trimmed.length) {
          out.push(trimmed.length);
        }
        return out;
      };
      var count = 0;
      var cutBlock = -1;
      var cutAt = -1;
      for (var i = 0; i < blocks.length && cutBlock < 0; i++) {
        var e = ends(blocks[i].textContent);
        if (count + e.length >= SHOWN) {
          cutBlock = i;
          cutAt = e[SHOWN - count - 1];
        }
        count += e.length;
      }
      if (cutBlock < 0) return;
      var hide = [];
      var block = blocks[cutBlock];
      if (block.textContent.slice(cutAt).trim()) {
        // The second sentence ends inside a paragraph: move the rest of that paragraph into a hidden span.
        var walker = document.createTreeWalker(block, NodeFilter.SHOW_TEXT);
        var seen = 0;
        var node;
        while ((node = walker.nextNode())) {
          if (seen + node.nodeValue.length >= cutAt) break;
          seen += node.nodeValue.length;
        }
        if (!node) return;
        var range = document.createRange();
        range.setStart(node, cutAt - seen);
        range.setEnd(block, block.childNodes.length);
        var span = document.createElement('span');
        span.className = 'cdesc__rest';
        span.appendChild(range.extractContents());
        block.appendChild(span);
        hide.push(span);
      }
      for (var j = cutBlock + 1; j < blocks.length; j++) {
        if (blocks[j] !== text && blocks[j].textContent.trim()) hide.push(blocks[j]);
      }
      if (!hide.length) return;
      if (block !== text) block.classList.add('cdesc__cut');
      hide.forEach(function (el) {
        el.hidden = true;
      });
      root.classList.add('is-folded');
      toggle.addEventListener('click', function () {
        var open = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(open));
        root.classList.toggle('is-open', open);
        hide.forEach(function (el) {
          el.hidden = !open;
        });
      });
    };
    var scripts = document.getElementsByTagName('script');
    var me = document.currentScript || scripts[scripts.length - 1];
    setup(me && me.previousElementSibling);
    if (!window.cdescEditorListener) {
      window.cdescEditorListener = true;
      document.addEventListener('shopify:section:load', function (event) {
        event.target.querySelectorAll('[data-cdesc]').forEach(setup);
      });
    }
  })();
</script>
